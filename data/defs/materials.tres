[gd_resource type="Resource" script_class="MaterialDefs" format=3]

[ext_resource type="Script" path="res://src/inventory/material_defs.gd" id="1_reg"]
[ext_resource type="Script" path="res://src/inventory/material_def.gd" id="2_def"]

; M4a contract §4. Colours and nutrition values are PLACEHOLDER.
; Keys are saved in item snapshots: never rename. Tile materials use the
; TileDef key and placeholder colour of the tile they drop from.

[sub_resource type="Resource" id="Mat_dirt"]
script = ExtResource("2_def")
key = &"dirt"
display_name = "Dirt"
color = Color(0.45, 0.31, 0.2, 1)
category = &"soil"
nutrition_per_kg = 0.0

