[resource]
script = ExtResource("1_reg")
defs = Array[Resource]([SubResource("Mat_dirt"), SubResource("Mat_rock"), SubResource("Mat_iron_ore"), SubResource("Mat_gold_ore"), SubResource("Mat_crystal"), SubResource("Mat_mushroom"), SubResource("Mat_meal"), SubResource("Mat_ration")])
